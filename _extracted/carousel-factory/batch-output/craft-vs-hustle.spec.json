        "scriptPrefix": "Build",
        "displayLine1": "DEPTH",
        "displayLine2": "BEATS",
        "displayLine3": "REACH",
        "body": "Vanity metrics fade by morning. Makers build objects and relationships that endure. Legacy is measured in decades, not notifications.",
        "handle": "@atelier",
        "slideId": "Slide 07"
      }
    },
