      }
    },
    {
      "layoutId": "body-noir-yellow",
      "slots": {
        "brand": "ATELIER",
        "scriptPrefix": "Breathe",
        "displayLine1": "REST",
        "displayLine2": "IS",
        "displayLine3": "PROCESS",
        "body": "Hustlers glorify burnout. Makers know that stepping away returns clarity and better work. Rest is not a reward; it is a requirement.",
        "handle": "@atelier",
        "slideId": "Slide 02"
      }
    },
    {
      "layoutId": "body-noir-yellow",
      "slots": {
        "brand": "ATELIER",
        "scriptPrefix": "Slow",
        "displayLine1": "SLOW",
        "displayLine2": "IS",
        "displayLine3": "PRECISE",
        "body": "Speed creates noise. Deliberate slowness sharpens the eye and steadies the hand. True quality cannot be rushed into existence.",
        "handle": "@atelier",
        "slideId": "Slide 03"
      }
    },
    {
      "layoutId": "body-noir-yellow",
      "slots": {
        "brand": "ATELIER",
        "scriptPrefix": "Listen",
        "displayLine1": "WORK",
        "displayLine2": "SPEAKS",
        "displayLine3": "LOUDER",
        "body": "Hustlers sell the dream before building it. Makers let the finished piece do the talking. Substance always outlasts the pitch.",
        "handle": "@atelier",
        "slideId": "Slide 04"
      }
    },
    {
      "layoutId": "body-noir-yellow",
      "slots": {
        "brand": "ATELIER",
        "scriptPrefix": "Honor",
        "displayLine1": "TOOLS",
        "displayLine2": "ARE",
        "displayLine3": "SACRED",
        "body": "A maker cleans, maintains, and understands every tool. Respect for the instrument shows respect for the craft. Mastery lives in the details.",
        "handle": "@atelier",
        "slideId": "Slide 05"
      }
    },
    {
      "layoutId": "body-noir-yellow",
      "slots": {
        "brand": "ATELIER",
        "scriptPrefix": "Adjust",
        "displayLine1": "MISTAKES",
        "displayLine2": "ARE",
        "displayLine3": "MAPPED",
        "body": "Every error reveals the true grain of the material. Makers study missteps instead of hiding them. Failure is simply feedback with texture.",
        "handle": "@atelier",
        "slideId": "Slide 06"
      }
    },
    {
      "layoutId": "body-noir-yellow",
      "slots": {
