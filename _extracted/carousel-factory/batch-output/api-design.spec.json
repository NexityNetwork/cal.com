        "titleMain": "Errors stay",
        "titleOrange": "consistent",
        "body": "Return consistent JSON error objects with type, message, and param fields. Clients parse once, alerts aggregate cleanly, and debugging stops being a guessing game.",
        "codePill": "{ \"error\": \"invalid_param\" }",
        "handle": "@hookengine"
      }
    },
    {
      "layoutId": "body-dark-navy",
