        "number": "2",
        "titleMain": "Write once",
        "titleOrange": "safely",
        "body": "Require Idempotency-Key headers on mutating operations. It prevents duplicate charges, retries become safe, and your logs stay deterministic across network blips.",
        "codePill": "Idempotency-Key: <uuid>",
        "handle": "@hookengine"
      }
    },
