        "headLine1": "The",
        "headLine2": "API",
        "headLine3": "That Scales",
        "subline": "Six design principles we used to cut integration maintenance by an order of magnitude.",
        "stat1Num": "10x",
        "stat1Label": "easier to maintain",
        "stat2Num": "6",
        "stat2Label": "core design principles",
        "stat3Num": "99.9%",
        "stat3Label": "service uptime target",
        "ctaLabel": "Read the thread",
        "totalSlides": "8"
      }
    },
    {
      "layoutId": "body-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "02/08",
        "stepLabel": "# explicitly version all api endpoints",
        "number": "1",
        "titleMain": "Version in",
        "titleOrange": "URL",
        "body": "Never break existing consumers. Lock major versions into the path so teams can migrate on their own schedule without header gymnastics.",
        "codePill": "GET /v1/orders/:id",
        "handle": "@apifoundry"
      }
    },
    {
      "layoutId": "body-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "03/08",
        "stepLabel": "# make mutations safe to retry",
        "number": "2",
        "titleMain": "Idempotent state",
        "titleOrange": "changes",
        "body": "Supply a unique key for every state-changing request. It prevents double-charges, duplicate records, and noisy support tickets.",
        "codePill": "Idempotency-Key: <uuid>",
        "handle": "@apifoundry"
      }
    },
    {
      "layoutId": "body-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "04/08",
        "stepLabel": "# paginate with cursors not offsets",
        "number": "3",
        "titleMain": "Cursor based",
        "titleOrange": "pages",
        "body": "Offset queries slow down and skip rows under concurrent writes. Cursors stay consistent, scale with large datasets, and simplify client logic.",
        "codePill": "?cursor=eyJpZCI6MX0",
        "handle": "@apifoundry"
      }
    },
    {
      "layoutId": "body-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "05/08",
        "stepLabel": "# always return structured error payloads",
        "number": "4",
        "titleMain": "Structured error",
        "titleOrange": "responses",
        "body": "Use a uniform schema for every failure. Include machine-readable type, human message, and docs URL so debuggers never guess.",
        "codePill": "{ \"error\": \"invalid_param\" }",
        "handle": "@apifoundry"
      }
    },
    {
      "layoutId": "body-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "06/08",
        "stepLabel": "# sign every outgoing webhook payload",
        "number": "5",
        "titleMain": "Payload signing",
        "titleOrange": "required",
        "body": "Clients verify authenticity with a shared secret and timestamp. Reject unverified payloads to eliminate spoofing and replay attacks.",
        "codePill": "X-Signature: sha256=...",
        "handle": "@apifoundry"
      }
    },
    {
      "layoutId": "body-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "07/08",
        "stepLabel": "# let callers expand related data",
        "number": "6",
        "titleMain": "Query patterns",
        "titleOrange": "work",
        "body": "Use sparse fieldsets and embedded expansions to kill N+1 calls. One request should return exactly what the UI needs.",
        "codePill": "?expand=account&fields=id,email",
        "handle": "@apifoundry"
      }
    },
    {
      "layoutId": "cta-dark-navy",
      "slots": {
        "brand": "ApiFoundry",
        "pageOf": "08/08",
        "terminalTag": "npm run deploy --target=your-feed --confirm",
        "headLine1": "Ship",
        "headLine2": "cleaner APIs",
        "body": "Apply these six patterns and watch your integration backlog shrink. Your future maintainers will thank you.",
        "buttonLabel": "Follow for more",
