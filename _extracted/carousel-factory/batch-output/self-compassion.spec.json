        "numberLabel": "Practice",
        "titleMain": "Honor your",
        "titleItalic": "truth",
        "body": "It is okay to say 'I am not okay right now.' Setting boundaries with forced optimism protects your energy and restores authenticity.",
        "handle": "@mayabennett"
      }
