        "titleAccent": "headers",
        "titleItalic": "in one flag",
        "subtitle": "Skip GUI clients and authenticate APIs directly from the terminal with zero config files.",
        "termTitle": "~/scripts/api-auth.sh",
        "termBadge": "BASH",
        "cmtLine": "# send JWT token without shell history exposure",
        "cmd1": "curl -H \\\"Authorization: Bearer $TOKEN\\\" \\\\",
        "cmd2": "  -H \\\"Accept: application/json\\\" \\\\",
        "cmd3": "  https://api.kernelhq.dev/v1/me",
        "out1": "HTTP/2 200  content-type:",
        "out1Hl": "applic/json",
