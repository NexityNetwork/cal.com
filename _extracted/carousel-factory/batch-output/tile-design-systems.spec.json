        "titleLine1": "Stop Using Pure",
        "titleLine2": "Black in UI",
        "badColor": "#000000",
        "badLabel": "Pure Black",
        "goodColor": "#111827",
        "goodLabel": "Rich Black"
      }
    },
    {
      "layoutId": "body-design-tile",
      "slots": {
        "number": "02",
        "handle": "@usevisuals",
        "titleLine1": "Use an Eight",
        "titleAccent": "Point Grid",
        "attr1": "Predictable",
        "attr2": "Scalable",
        "attr3": "Faster",
        "attr4": "Cleaner",
        "body": "Align every element to an 8pt baseline. It removes guesswork and keeps spacing predictable across breakpoints."
      }
    },
    {
      "layoutId": "body-design-tile",
      "slots": {
        "number": "03",
        "handle": "@usevisuals",
        "titleLine1": "Hit WCAG Targets",
        "titleAccent": "Every Time",
        "attr1": "Readable",
        "attr2": "Inclusive",
        "attr3": "Legal",
        "attr4": "Clear",
        "body": "Never ship text below 4.5:1 contrast. Accessible palettes expand your audience and reduce liability."
      }
    },
    {
      "layoutId": "body-design-tile",
      "slots": {
        "number": "04",
        "handle": "@usevisuals",
        "titleLine1": "Name Your Colors",
        "titleAccent": "As Tokens",
        "attr1": "Flexible",
        "attr2": "Themable",
        "attr3": "Maintainable",
        "attr4": "Logical",
        "body": "Replace hex codes with semantic names like surface-brand. Tokens let you reskin an entire product in minutes."
      }
    },
    {
      "layoutId": "body-design-tile",
      "slots": {
        "number": "05",
        "handle": "@usevisuals",
        "titleLine1": "Build a Type",
        "titleAccent": "Scale System",
        "attr1": "Harmonic",
        "attr2": "Readable",
        "attr3": "Unified",
        "attr4": "Professional",
        "body": "Limit styles to four weights and defined sizes. A rigid scale creates rhythm and reduces decision fatigue."
      }
    },
    {
      "layoutId": "body-design-tile",
      "slots": {
        "number": "06",
        "handle": "@usevisuals",
        "titleLine1": "Keep Figma Code",
        "titleAccent": "In Sync",
        "attr1": "Accurate",
        "attr2": "Aligned",
        "attr3": "Faster",
        "attr4": "Single Source",
        "body": "Mirror component variants between design and development. One source of truth prevents drift and speeds up handoff."
      }
    },
    {
      "layoutId": "body-design-tile",
      "slots": {
        "number": "07",
        "handle": "@usevisuals",
        "titleLine1": "Let Content Drive",
        "titleAccent": "The Layout",
        "attr1": "Adaptive",
        "attr2": "Purposeful",
        "attr3": "Fluid",
        "attr4": "User First",
        "body": "Copy and images should shape the interface, not the other way around. Content-first design adapts to any screen."
      }
    },
    {
      "layoutId": "cta-design-tile",
      "slots": {
        "number": "08",
        "handle": "@usevisuals",
        "eyebrow": "STEAL THESE",
        "headlineLine1": "System Rules",
        "headlineLine2": "That Scale",
        "body": "Apply these six principles to ship faster, cleaner interfaces. Your team will thank you.",
        "buttonLabel": "Apply These Principles Now"
      }
    }
