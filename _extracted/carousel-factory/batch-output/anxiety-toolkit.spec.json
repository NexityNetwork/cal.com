        "number": "3",
        "numberLabel": "Tool",
        "titleMain": "Cold Water",
        "titleItalic": "reset",
        "body": "Splash cold water on your face or hold an ice cube. This activates the dive reflex and rapidly slows a racing heart.",
        "handle": ""
      }
    },
    {
      "layoutId": "body-pastel-soft",
      "slots": {
        "authorName": "Sara Lin",
        "pageOf": "5 / 8",
        "number": "4",
        "numberLabel": "Tool",
        "titleMain": "Muscle Release",
        "titleItalic": "softly",
        "body": "Tense each muscle group for five seconds, then release. Moving from toes to shoulders melts physical stress you didn't know you held.",
        "handle": ""
      }
    },
    {
      "layoutId": "body-pastel-soft",
      "slots": {
        "authorName": "Sara Lin",
        "pageOf": "6 / 8",
        "number": "5",
        "numberLabel": "Tool",
        "titleMain": "Name It",
        "titleItalic": "quietly",
        "body": "Simply say 'I am feeling anxious' out loud. Labeling emotions reduces amygdala activity and gives your brain a sense of control.",
        "handle": ""
      }
    },
